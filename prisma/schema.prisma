// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Restaurant (tenant)
// ---------------------------------------------------------------------------

model Restaurant {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  tagline        String?
  logoUrl        String?
  coverUrl       String?
  defaultLocale  String   @default("pt")
  enabledLocales String[] @default(["pt", "en"])
  currency       String   @default("EUR")
  theme          Json     @default("{}")
  googleReviewUrl String?
  address        String?
  phone          String?
  email          String?
  instagramHandle String?
  openingHours   Json?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories       Category[]
  memberships      Membership[]
  reviews          Review[]
  analyticsEvents  AnalyticsEvent[]
  waiterCalls      WaiterCall[]
}


model Membership {
  id           String           @id @default(cuid())
  restaurantId String
  userId       String
  role         MembershipRole   @default(STAFF)
  createdAt    DateTime         @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
}

enum MembershipRole {
  OWNER
  STAFF
  ADMIN
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  sortOrder    Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]
  translations CategoryTranslation[]
}

model CategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Dish {
  id          String   @id @default(cuid())
  categoryId  String
  pricecents  Int
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isSpecial   Boolean  @default(false)
  allergens   Allergen[]
  dietaryTags DietaryTag[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations DishTranslation[]
}

model DishTranslation {
  id          String  @id @default(cuid())
  dishId      String
  locale      String
  name        String
  description String? @db.Text

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, locale])
}

// EU Regulation (EU) No 1169/2011 — 14 major allergens
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum DietaryTag {
  VEGAN
  VEGETARIAN
  BEEF
  PORK
  CHICKEN
  FISH
  SEAFOOD
  OLD_GOAT
}

// ---------------------------------------------------------------------------
// Customer feedback (sub-4 star reviews stored for the restaurant owner)
// ---------------------------------------------------------------------------

model Review {
  id           String   @id @default(cuid())
  restaurantId String
  rating       Int
  comment      String?  @db.Text
  locale       String?
  tableNumber  String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  restaurantId String
  type         String   // page_view | dish_view | language_change | qr_scan
  meta         Json?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model WaiterCall {
  id           String   @id @default(cuid())
  restaurantId String
  tableNumber  String
  type         String   @default("waiter") // waiter | bill | help
  note         String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
