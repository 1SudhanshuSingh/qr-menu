# Database (Neon — use pooled URL for runtime, direct URL for prisma db push/migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech:5432/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# Auth.js
AUTH_SECRET=""  # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon Object Storage (S3-compatible) — bucket named "images"
AWS_ENDPOINT_URL_S3="https://…neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="images"

# Optional
# DEEPL_API_KEY=""
